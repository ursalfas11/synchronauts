{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook SessionStart", "timeout": 60}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook UserPromptSubmit", "timeout": 10}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook PostToolUse", "timeout": 10}]}
    ],
    "Notification": [
      {"matcher": "permission_prompt|elicitation_dialog", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook Notification", "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook Stop", "async": true, "asyncRewake": true, "timeout": 28800}]}
    ],
    "StopFailure": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook StopFailure", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/syn.py\" hook SessionEnd", "timeout": 10}]}
    ]
  }
}
